{
  "name": "marked_and_worked",
  "saveFile": "minimal_colony.rws",
  "steps": [
    {"comment": "Issue #8's open §1 item: a marked order that is ALSO being worked, where this mod's red outline, its green in-progress edge and vanilla's 'would not start now' tint all land on one row. Framed next to a row that is worked but not marked, so the two can be compared in one frame rather than across captures.",
     "type": "SetTerrain", "args": {"def": "Concrete", "width": "14", "height": "10"}},
    {"type": "PlaceThings", "args": {"def": "ElectricStove", "layout": "cells", "cells": "-3,0; 3,0", "rot": "South"}},
    {"type": "SpawnPawn", "args": {"kind": "Colonist", "count": "2", "faction": "player", "spacing": "2", "offset": "-2,-3"}},
    {"type": "WbgLinkBenches", "args": {"def": "ElectricStove", "limit": "2"}},
    {"type": "Probe", "args": {"probeName": "wbg_group_size", "expectedValue": "2", "tolerance": "0"}},

    {"comment": "Counts of one, so a single claim makes the overshoot guard report 'would not start now' and vanilla tints the row.",
     "type": "WbgAddBill", "args": {"recipe": "CookMealSimple", "count": "1"}},
    {"type": "WbgAddBill", "args": {"recipe": "CookMealFine", "count": "1"}},
    {"type": "WbgAddBill", "args": {"recipe": "CookMealSurvival", "count": "1"}},

    {"comment": "Worked, not marked: the control row.",
     "type": "WbgSimulateBillStart", "args": {"requireDistinct": "true"}},
    {"type": "Probe", "args": {"probeName": "wbg_first_bill_should_do_now", "expectedValue": "0", "tolerance": "0"}},

    {"comment": "Marked, then worked by a second pawn: the row under test.",
     "type": "WbgMarkNextOrder", "args": {"slot": "1"}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "213", "tolerance": "0"}},
    {"type": "WbgSimulateBillStart", "args": {"requireDistinct": "true"}},
    {"type": "Probe", "args": {"probeName": "wbg_next_order_slot", "expectedValue": "1", "tolerance": "0"}},
    {"type": "Probe", "args": {"probeName": "wbg_marked_bill_should_do_now", "expectedValue": "0", "tolerance": "0"}},

    {"type": "WbgFocusBench", "args": {"def": "ElectricStove", "index": "1"}},
    {"type": "LookAt", "args": {"zoom": "11"}},
    {"type": "Wait", "args": {"frames": "20"}},
    {"type": "Screenshot", "args": {"fileName": "marked_and_worked.png", "hideUi": "false"}}
  ]
}
