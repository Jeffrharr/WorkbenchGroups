{
  "name": "batched_round_robin",
  "saveFile": "minimal_colony.rws",
  "steps": [
    {"type": "SetTerrain", "args": {"def": "Concrete", "width": "14", "height": "10"}},
    {"type": "PlaceThings", "args": {"def": "ElectricStove", "layout": "cells", "cells": "-3,0; 3,0", "rot": "South"}},
    {"type": "SpawnPawn", "args": {"kind": "Colonist", "count": "3", "faction": "player", "spacing": "2", "offset": "-2,-3"}},

    {"comment": "Linked in order and the bills queued BEFORE round robin goes on, so the switch has an authored order to snapshot. Linking straight into round robin snapshots an empty list, and the restore at the end would then pass vacuously.",
     "type": "WbgLinkBenches", "args": {"def": "ElectricStove", "limit": "2"}},
    {"type": "Probe", "args": {"probeName": "wbg_group_size", "expectedValue": "2", "tolerance": "0"}},
    {"type": "WbgAddBill", "args": {"recipe": "CookMealSimple", "count": "20"}},
    {"type": "WbgAddBill", "args": {"recipe": "CookMealFine", "count": "20"}},
    {"type": "WbgAddBill", "args": {"recipe": "CookMealSurvival", "count": "20"}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "123", "tolerance": "0"}},

    {"comment": "Negative control: in order ignores batches entirely, and starting the head bill moves nothing.",
     "type": "WbgSetBatch", "args": {"slot": "0", "size": "3"}},
    {"type": "WbgSimulateBillStart", "args": {}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "123", "tolerance": "0"}},

    {"type": "WbgSetOrdering", "args": {"mode": "RoundRobin"}},
    {"type": "Probe", "args": {"probeName": "wbg_ordering_mode", "expectedValue": "1", "tolerance": "0"}},
    {"type": "WbgSetBatch", "args": {"slot": "0", "size": "1"}},

    {"comment": "Unbatched frame for the A/B: identical scene, batch of one, so no badge.",
     "type": "WbgFocusBench", "args": {"def": "ElectricStove", "index": "1"}},
    {"type": "LookAt", "args": {"zoom": "11"}},
    {"type": "Wait", "args": {"frames": "20"}},
    {"type": "Screenshot", "args": {"fileName": "batch_off.png", "hideUi": "false"}},

    {"type": "WbgSetBatch", "args": {"slot": "0", "size": "3"}},
    {"type": "WbgFocusBench", "args": {"def": "ElectricStove", "index": "1"}},
    {"type": "LookAt", "args": {"zoom": "11"}},
    {"type": "Wait", "args": {"frames": "20"}},
    {"type": "Screenshot", "args": {"fileName": "batch_on.png", "hideUi": "false"}},

    {"comment": "Batch of three: the head holds for two starts and rotates on the third.",
     "type": "WbgSimulateBillStart", "args": {}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "123", "tolerance": "0"}},
    {"type": "WbgSimulateBillStart", "args": {}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "123", "tolerance": "0"}},
    {"type": "WbgSimulateBillStart", "args": {}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "231", "tolerance": "0"}},

    {"comment": "Unbatched bills still rotate on every start, so the cadence is per bill, not per group.",
     "type": "WbgSimulateBillStart", "args": {}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "312", "tolerance": "0"}},
    {"type": "WbgSimulateBillStart", "args": {}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "123", "tolerance": "0"}},

    {"comment": "The count restarted on rotation: slot 0 is back at the head and holds again.",
     "type": "WbgSimulateBillStart", "args": {}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "123", "tolerance": "0"}},

    {"comment": "Changing the batch restarts its count: picking two part-way through a batch means two from now. (Lowering below a running count is covered offline in BillOrderingTests.)",
     "type": "WbgSetBatch", "args": {"slot": "0", "size": "2"}},
    {"type": "WbgSimulateBillStart", "args": {}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "123", "tolerance": "0"}},
    {"type": "WbgSimulateBillStart", "args": {}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "231", "tolerance": "0"}},

    {"comment": "A marked order is exempt from the cadence: batch or no batch, it never rotates away.",
     "type": "WbgMarkNextOrder", "args": {"slot": "2"}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "321", "tolerance": "0"}},
    {"type": "WbgSimulateBillStart", "args": {}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "321", "tolerance": "0"}},
    {"type": "WbgMarkNextOrder", "args": {"slot": "-1"}},

    {"comment": "Snapshot restore: back to in order puts the authored 1-2-3 back despite the rotations above.",
     "type": "WbgSetOrdering", "args": {"mode": "InOrder"}},
    {"type": "Probe", "args": {"probeName": "wbg_ordering_mode", "expectedValue": "0", "tolerance": "0"}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "123", "tolerance": "0"}},

    {"type": "Probe", "args": {"probeName": "wbg_bills_visible_at_second_bench", "expectedValue": "3", "tolerance": "0"}}
  ]
}
