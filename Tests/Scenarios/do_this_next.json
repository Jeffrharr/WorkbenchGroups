{
  "name": "do_this_next",
  "saveFile": "minimal_colony.rws",
  "steps": [
    {"type": "SetTerrain", "args": {"def": "Concrete", "width": "14", "height": "10"}},
    {"type": "PlaceThings", "args": {"def": "ElectricStove", "layout": "cells", "cells": "-3,0; 3,0", "rot": "South"}},
    {"type": "WbgLinkBenches", "args": {"def": "ElectricStove", "limit": "2", "mode": "RoundRobin"}},
    {"type": "Probe", "args": {"probeName": "wbg_group_size", "expectedValue": "2", "tolerance": "0"}},

    {"type": "WbgAddBill", "args": {"recipe": "CookMealSimple", "count": "5"}},
    {"type": "WbgAddBill", "args": {"recipe": "CookMealFine", "count": "5"}},
    {"type": "WbgAddBill", "args": {"recipe": "CookMealSurvival", "count": "1"}},

    {"type": "Probe", "args": {"probeName": "wbg_next_order_slot", "expectedValue": "-1", "tolerance": "0"}},
    {"type": "Probe", "args": {"probeName": "wbg_head_bill_slot", "expectedValue": "0", "tolerance": "0"}},

    {"type": "WbgFocusBench", "args": {"def": "ElectricStove", "index": "1"}},
    {"type": "LookAt", "args": {"zoom": "11"}},
    {"type": "Wait", "args": {"frames": "20"}},
    {"type": "Screenshot", "args": {"fileName": "do_this_next_before.png", "hideUi": "false"}},

    {"type": "WbgMarkNextOrder", "args": {"slot": "2"}},
    {"type": "Probe", "args": {"probeName": "wbg_next_order_slot", "expectedValue": "2", "tolerance": "0"}},
    {"type": "Probe", "args": {"probeName": "wbg_head_bill_slot", "expectedValue": "2", "tolerance": "0"}},

    {"type": "WbgFocusBench", "args": {"def": "ElectricStove", "index": "1"}},
    {"type": "LookAt", "args": {"zoom": "11"}},
    {"type": "Wait", "args": {"frames": "20"}},
    {"type": "Screenshot", "args": {"fileName": "do_this_next_after.png", "hideUi": "false"}},

    {"type": "WbgSimulateBillStart", "args": {}},
    {"type": "Probe", "args": {"probeName": "wbg_head_bill_slot", "expectedValue": "2", "tolerance": "0"}},
    {"type": "Probe", "args": {"probeName": "wbg_next_order_slot", "expectedValue": "2", "tolerance": "0"}},

    {"type": "WbgMarkNextOrder", "args": {"slot": "0"}},
    {"type": "Probe", "args": {"probeName": "wbg_next_order_slot", "expectedValue": "0", "tolerance": "0"}},
    {"type": "Probe", "args": {"probeName": "wbg_head_bill_slot", "expectedValue": "0", "tolerance": "0"}},

    {"type": "WbgMarkNextOrder", "args": {"slot": "0"}},
    {"type": "Probe", "args": {"probeName": "wbg_next_order_slot", "expectedValue": "-1", "tolerance": "0"}},

    {"type": "WbgMarkNextOrder", "args": {"slot": "1"}},
    {"type": "Probe", "args": {"probeName": "wbg_next_order_slot", "expectedValue": "1", "tolerance": "0"}},
    {"type": "WbgDeleteBill", "args": {"slot": "1"}},
    {"type": "Probe", "args": {"probeName": "wbg_next_order_slot", "expectedValue": "-1", "tolerance": "0"}},

    {"type": "Probe", "args": {"probeName": "wbg_bills_visible_at_second_bench", "expectedValue": "2", "tolerance": "0"}}
  ]
}
