{
  "name": "nicebilltab_do_next_button",
  "saveFile": "minimal_colony.rws",

  "comment": "The 'do this next' button above Nice Bill Tab's list: inert with nothing selected and with several selected, marks the single selected order, and unmarks it again. Selection goes through their own SelectBill; the press goes through the button's own handler.",
  "requiredMods": { "Andromeda.NiceBillTab": "3520130671" },

  "steps": [
    { "type": "SetTerrain", "args": { "def": "Concrete", "width": "14", "height": "10" } },
    { "type": "PlaceThings", "args": { "def": "ElectricStove", "layout": "cells", "cells": "-3,0; 3,0", "rot": "South" } },
    { "type": "WbgClaimBenches", "args": { "def": "ElectricStove" } },
    { "type": "WbgLinkBenches", "args": { "def": "ElectricStove", "limit": "2", "mode": "InOrder" } },

    { "type": "WbgAddBill", "args": { "recipe": "CookMealSimple", "count": "5" } },
    { "type": "WbgAddBill", "args": { "recipe": "CookMealFine", "count": "5" } },
    { "type": "WbgAddBill", "args": { "recipe": "CookMealSurvival", "count": "5" } },

    { "type": "WbgFocusBench", "args": { "def": "ElectricStove", "index": "1" } },
    { "type": "LookAt", "args": { "zoom": "12" } },
    { "type": "Wait", "args": { "frames": "20" } },
    { "comment": "First capture carries the HUD regardless; spent.", "type": "Screenshot", "args": { "fileName": "nbt_donext_warmup.png", "hideUi": "false" } },

    { "type": "WbgNbtSelectBill", "args": { "slot": "-1" } },
    { "comment": "Nothing selected: the press must refuse.", "type": "WbgNbtPressDoNext", "args": { "expectActed": "false" } },
    { "type": "Probe", "args": { "probeName": "wbg_next_order_slot", "expectedValue": "-1", "tolerance": "0" } },

    { "type": "WbgNbtSelectBill", "args": { "slot": "0" } },
    { "type": "WbgNbtSelectBill", "args": { "slot": "1", "add": "true" } },
    { "comment": "Two selected, as shift-click makes: marking is one per group, so the press must refuse rather than pick one.", "type": "WbgNbtPressDoNext", "args": { "expectActed": "false" } },
    { "type": "Probe", "args": { "probeName": "wbg_next_order_slot", "expectedValue": "-1", "tolerance": "0" } },

    { "type": "WbgNbtSelectBill", "args": { "slot": "2" } },
    { "type": "Wait", "args": { "frames": "10" } },
    { "type": "Screenshot", "args": { "fileName": "nbt_donext_selected.png", "hideUi": "false" } },

    { "type": "WbgNbtPressDoNext", "args": { "expectActed": "true" } },
    { "type": "Probe", "args": { "probeName": "wbg_next_order_slot", "expectedValue": "2", "tolerance": "0" } },
    { "type": "Probe", "args": { "probeName": "wbg_head_bill_slot", "expectedValue": "2", "tolerance": "0" } },
    { "type": "Wait", "args": { "frames": "10" } },
    { "type": "Screenshot", "args": { "fileName": "nbt_donext_marked.png", "hideUi": "false" } },

    { "comment": "Pressing again with the marked order selected unmarks it, like vanilla's toggle.", "type": "WbgNbtPressDoNext", "args": { "expectActed": "true" } },
    { "type": "Probe", "args": { "probeName": "wbg_next_order_slot", "expectedValue": "-1", "tolerance": "0" } }
  ]
}
