{
  "name": "nicebilltab_ordering",
  "saveFile": "minimal_colony.rws",

  "comment_requiredMods": "Issue #8's ordering features, seen through Nice Bill Tab's replacement tab (the parity rule in CLAUDE.md). Run with --mod NiceBillTabLinuxDrag, as nicebilltab_compat is.",
  "requiredMods": { "Andromeda.NiceBillTab": "3520130671" },

  "steps": [
    { "type": "SetTerrain", "args": { "def": "Concrete", "width": "14", "height": "10" } },
    { "type": "PlaceThings", "args": { "def": "ElectricStove", "layout": "cells", "cells": "-3,0; 3,0", "rot": "South" } },
    { "type": "WbgClaimBenches", "args": { "def": "ElectricStove" } },
    { "type": "WbgLinkBenches", "args": { "def": "ElectricStove", "limit": "2", "mode": "RoundRobin" } },
    { "type": "Probe", "args": { "probeName": "wbg_group_size", "expectedValue": "2", "tolerance": "0" } },

    { "type": "WbgAddBill", "args": { "recipe": "CookMealSimple", "count": "5" } },
    { "type": "WbgAddBill", "args": { "recipe": "CookMealFine", "count": "5" } },
    { "type": "WbgAddBill", "args": { "recipe": "CookMealSurvival", "count": "5" } },

    {
      "comment": "A batch of three on the first order: the count should show on their compact row's thumbnail-corner chain, read-only.",
      "type": "WbgSetBatch", "args": { "slot": "0", "size": "3" }
    },

    { "type": "WbgFocusBench", "args": { "def": "ElectricStove", "index": "1" } },
    { "type": "LookAt", "args": { "zoom": "12" } },
    { "type": "Wait", "args": { "frames": "20" } },
    {
      "comment": "First capture of a scenario carries the HUD regardless of hideUi, so this one is spent.",
      "type": "Screenshot", "args": { "fileName": "nbt_order_warmup.png", "hideUi": "false" }
    },
    { "type": "Wait", "args": { "frames": "10" } },
    { "type": "Screenshot", "args": { "fileName": "nbt_batch_count.png", "hideUi": "false" } },

    {
      "comment": "Balance plus one-each-first: the ordering button in their pane has to name both, through the same OrderingMenu.Describe the vanilla tab uses.",
      "type": "WbgSetOrdering", "args": { "mode": "Balance" }
    },
    { "type": "WbgSetOneEachFirst", "args": { "on": "true" } },
    { "type": "Probe", "args": { "probeName": "wbg_ordering_mode", "expectedValue": "12", "tolerance": "0" } },

    {
      "comment": "A direct list move (their drag's effect, which no patch sees) under Balance. None of these orders has a target and none is short, so every key ties and the authored order decides. The move is absorbed into that order before the sort, so it survives (312). Without the absorb, the tie would fall to the pre-move order.",
      "type": "WbgMoveBillDirect", "args": { "slot": "2", "toIndex": "0" }
    },
    { "type": "WbgScanBench", "args": {} },
    { "type": "Probe", "args": { "probeName": "wbg_bill_order", "expectedValue": "312", "tolerance": "0" } },

    { "type": "WbgFocusBench", "args": { "def": "ElectricStove", "index": "1" } },
    { "type": "LookAt", "args": { "zoom": "12" } },
    { "type": "Wait", "args": { "frames": "20" } },
    { "type": "Screenshot", "args": { "fileName": "nbt_balance_button.png", "hideUi": "false" } }
  ]
}
