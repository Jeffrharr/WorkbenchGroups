{
  "name": "stock_aware_ordering",
  "saveFile": "minimal_colony.rws",
  "steps": [
    {"type": "SetTerrain", "args": {"def": "Concrete", "width": "16", "height": "12"}},
    {"type": "PlaceThings", "args": {"def": "ElectricStove", "layout": "cells", "cells": "-3,0; 3,0", "rot": "South"}},
    {"type": "SpawnPawn", "args": {"kind": "Colonist", "count": "3", "faction": "player", "spacing": "2", "offset": "-2,-3"}},

    {"comment": "Stock: 8 simple meals, 2 fine, no baby food. Every bill takes vanilla's slow count (slowCount), because the fast path reads the resource counter, which only sees stockpiles, and these meals are on bare floor.",
     "type": "PlaceThings", "args": {"def": "MealSimple", "layout": "cells", "cells": "-6,3; -5,3; -4,3; -3,3; -2,3; -1,3; 0,3; 1,3"}},
    {"type": "PlaceThings", "args": {"def": "MealFine", "layout": "cells", "cells": "-6,4; -5,4"}},

    {"type": "WbgLinkBenches", "args": {"def": "ElectricStove", "limit": "2"}},
    {"type": "Probe", "args": {"probeName": "wbg_group_size", "expectedValue": "2", "tolerance": "0"}},
    {"type": "WbgAddBill", "args": {"recipe": "CookMealSimple", "repeat": "target", "count": "10", "slowCount": "true"}},
    {"type": "WbgAddBill", "args": {"recipe": "CookMealFine", "repeat": "target", "count": "10", "slowCount": "true"}},
    {"comment": "Baby food, because it is the one stove product the fixture colony has none of on its map. The first two runs used packaged survival meals and then lavish meals, and the floor test failed both times for the same honest reason — the colony already had some (11 packs, 2 lavish), so the order was never short. Checked against the fixture's save, not assumed.",
     "type": "WbgAddBill", "args": {"recipe": "Make_BabyFood", "repeat": "forever", "slowCount": "true"}},

    {"comment": "Negative control: in order never sorts, however uneven the stock.",
     "type": "WbgScanBench", "args": {}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "123", "tolerance": "0"}},

    {"comment": "Balance: fine 2/10 before simple 8/10, the do-forever order after both. Switching alone does not sort; the next scan does.",
     "type": "WbgSetOrdering", "args": {"mode": "Balance"}},
    {"type": "Probe", "args": {"probeName": "wbg_ordering_mode", "expectedValue": "2", "tolerance": "0"}},
    {"type": "Probe", "args": {"probeName": "wbg_member_reported_mode", "expectedValue": "2", "tolerance": "0"}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "123", "tolerance": "0"}},
    {"type": "WbgScanBench", "args": {"index": "1"}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "213", "tolerance": "0"}},

    {"comment": "Balance owns the order: the up arrow on the last row is refused.",
     "type": "WbgReorderBill", "args": {"slot": "2", "offset": "-1"}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "213", "tolerance": "0"}},

    {"comment": "A/B for the greyed arrows: the same list in the same order, Balance then round robin (which does not sort, so the order holds).",
     "type": "WbgFocusBench", "args": {"def": "ElectricStove", "index": "1"}},
    {"type": "LookAt", "args": {"zoom": "11"}},
    {"type": "Wait", "args": {"frames": "20"}},
    {"type": "Screenshot", "args": {"fileName": "balance_arrows_grey.png", "hideUi": "false"}},
    {"type": "WbgSetOrdering", "args": {"mode": "RoundRobin"}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "213", "tolerance": "0"}},
    {"type": "WbgFocusBench", "args": {"def": "ElectricStove", "index": "1"}},
    {"type": "LookAt", "args": {"zoom": "11"}},
    {"type": "Wait", "args": {"frames": "20"}},
    {"type": "Screenshot", "args": {"fileName": "balance_arrows_live.png", "hideUi": "false"}},

    {"comment": "Snapshot widening: round robin to in order restores the order authored before Balance, not Balance's sort.",
     "type": "WbgSetOrdering", "args": {"mode": "InOrder"}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "123", "tolerance": "0"}},
    {"type": "WbgSetOrdering", "args": {"mode": "Balance"}},
    {"type": "WbgScanBench", "args": {}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "213", "tolerance": "0"}},

    {"comment": "The count cache: eight more fine meals make fine 10/10, above simple's 8/10, but a scan inside the 60-tick window keeps the cached order. Past it, the recount flips them.",
     "type": "PlaceThings", "args": {"def": "MealFine", "layout": "cells", "cells": "-4,4; -3,4; -2,4; -1,4; 0,4; 1,4; 2,4; 3,4"}},
    {"type": "WbgScanBench", "args": {}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "213", "tolerance": "0"}},
    {"type": "AdvanceTicks", "args": {"ticks": "61"}},
    {"type": "WbgScanBench", "args": {}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "123", "tolerance": "0"}},

    {"comment": "The marker is the sort's top tier, so a re-sort keeps it first rather than burying it.",
     "type": "WbgMarkNextOrder", "args": {"slot": "2"}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "312", "tolerance": "0"}},
    {"type": "AdvanceTicks", "args": {"ticks": "61"}},
    {"type": "WbgScanBench", "args": {}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "312", "tolerance": "0"}},
    {"type": "WbgMarkNextOrder", "args": {"slot": "-1"}},
    {"type": "AdvanceTicks", "args": {"ticks": "61"}},
    {"type": "WbgScanBench", "args": {}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "123", "tolerance": "0"}},

    {"comment": "One of each first, layered on in order: the baby food order (none in stock) is lifted to the top.",
     "type": "WbgSetOrdering", "args": {"mode": "InOrder"}},
    {"type": "WbgSetOneEachFirst", "args": {"on": "true"}},
    {"type": "Probe", "args": {"probeName": "wbg_ordering_mode", "expectedValue": "10", "tolerance": "0"}},
    {"type": "WbgScanBench", "args": {}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "312", "tolerance": "0"}},

    {"comment": "The timing trap. A pawn starts the baby food order; stock still reads zero, but the start counts as one in flight and marks the group dirty, so the very next scan drops it back to its authored place instead of offering a second pawn the same one.",
     "type": "WbgSimulateBillStart", "args": {"requireDistinct": "true"}},
    {"type": "Probe", "args": {"probeName": "wbg_active_bill_slot", "expectedValue": "2", "tolerance": "0"}},
    {"type": "WbgScanBench", "args": {}},
    {"type": "Probe", "args": {"probeName": "wbg_bill_order", "expectedValue": "123", "tolerance": "0"}},

    {"comment": "'Do until you have X' clears its marker once stock reaches X, in a group that does not sort at all.",
     "type": "WbgSetOneEachFirst", "args": {"on": "false"}},
    {"type": "Probe", "args": {"probeName": "wbg_ordering_mode", "expectedValue": "0", "tolerance": "0"}},
    {"type": "WbgMarkNextOrder", "args": {"slot": "0"}},
    {"type": "AdvanceTicks", "args": {"ticks": "61"}},
    {"type": "WbgScanBench", "args": {}},
    {"type": "Probe", "args": {"probeName": "wbg_next_order_slot", "expectedValue": "0", "tolerance": "0"}},
    {"type": "PlaceThings", "args": {"def": "MealSimple", "layout": "cells", "cells": "2,3; 3,3"}},
    {"type": "WbgScanBench", "args": {}},
    {"type": "Probe", "args": {"probeName": "wbg_next_order_slot", "expectedValue": "0", "tolerance": "0"}},
    {"type": "AdvanceTicks", "args": {"ticks": "61"}},
    {"type": "WbgScanBench", "args": {}},
    {"type": "Probe", "args": {"probeName": "wbg_next_order_slot", "expectedValue": "-1", "tolerance": "0"}},

    {"type": "Probe", "args": {"probeName": "wbg_bills_visible_at_second_bench", "expectedValue": "3", "tolerance": "0"}}
  ]
}
